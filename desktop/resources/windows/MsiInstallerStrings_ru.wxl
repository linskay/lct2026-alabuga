<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ru-ru" Codepage="1251" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- Строки пакета jpackage -->
  <String Id="MainFeatureTitle">Основные компоненты программы</String>
  <String Id="DowngradeErrorMessage">На вашем компьютере уже установлена более новая версия [ProductName]. Установка отменена.</String>
  <String Id="DisallowUpgradeErrorMessage">На вашем компьютере уже установлена более ранняя версия [ProductName]. Обновление поверх невозможно. Установка будет завершена.</String>

  <!-- Диалог выбора ярлыков -->
  <String Id="ShortcutPromptDlg_Title">Установка [ProductName]</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}Ярлыки программы</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">Выберите, где создать ярлыки для быстрого запуска программы:</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Создать ярлык на Рабочем столе</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Добавить программу в меню «Пуск»</String>

  <!-- Диалог непустой папки -->
  <String Id="InstallDirNotEmptyDlg_Title">Установка [ProductName]</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">Папка «[INSTALLDIR]» уже существует. Вы действительно хотите установить приложение в эту папку?</String>

  <String Id="ContextMenuCommandLabel">Открыть с помощью [ProductName]</String>
  <String Id="OsConditionMessage">Для запуска [ProductName] требуется Windows 10 или более поздняя версия операционной системы.</String>

  <!-- Главное окно приветствия (WelcomeDlg) -->
  <String Id="WelcomeDlgTitle" Overridable="yes">{\WixUI_Font_Bigger}Добро пожаловать в мастер установки [ProductName]</String>
  <String Id="WelcomeDlgDescription" Overridable="yes">Программа установит «[ProductName]» на ваш компьютер.&#13;&#10;&#13;&#10;Мастер установки поможет быстро настроить и распаковать все необходимые компоненты.&#13;&#10;&#13;&#10;Нажмите кнопку «Далее», чтобы продолжить, или «Отмена» для выхода.</String>

  <!-- Диалог выбора папки (InstallDirDlg) -->
  <String Id="InstallDirDlgTitle" Overridable="yes">{\WixUI_Font_Title}Папка установки</String>
  <String Id="InstallDirDlgDescription" Overridable="yes">Выберите папку, в которую будет установлено приложение:</String>
  <String Id="InstallDirDlgFolderLabel" Overridable="yes">Установить [ProductName] в:</String>
  <String Id="InstallDirDlgChange" Overridable="yes">&amp;Обзор...</String>

  <!-- Диалог готовности к установке (VerifyReadyDlg) -->
  <String Id="VerifyReadyDlgInstallTitle" Overridable="yes">{\WixUI_Font_Title}Всё готово к установке</String>
  <String Id="VerifyReadyDlgInstallDescription" Overridable="yes">Все необходимые параметры заданы. Нажмите кнопку «Установить», чтобы начать установку программы на компьютер.</String>

  <!-- Окно успешного завершения (ExitDialog) -->
  <String Id="ExitDialogTitle" Overridable="yes">{\WixUI_Font_Bigger}Установка успешно завершена!</String>
  <String Id="ExitDialogDescription" Overridable="yes">Программа [ProductName] успешно установлена на ваш компьютер и готова к запуску.&#13;&#10;&#13;&#10;Нажмите «Готово», чтобы закрыть окно мастера установки.</String>

  <!-- Окно отмены пользователем (UserExit) -->
  <String Id="UserExitTitle" Overridable="yes">{\WixUI_Font_Bigger}Установка прервана</String>
  <String Id="UserExitDescription" Overridable="yes">Установка [ProductName] была отменена пользователем. Файлы программы не были изменены.</String>

  <!-- Окно ошибки (FatalError) -->
  <String Id="FatalErrorTitle" Overridable="yes">{\WixUI_Font_Bigger}Ошибка при установке</String>
  <String Id="FatalErrorDescription" Overridable="yes">Во время установки [ProductName] произошла непредвиденная ошибка. Пожалуйста, запустите установщик повторно от имени администратора.</String>

  <!-- Диалог подтверждения отмены (CancelDlg) -->
  <String Id="CancelDlgText" Overridable="yes">Вы уверены, что хотите прервать установку [ProductName]?</String>
  <String Id="CancelDlgYes" Overridable="yes">&amp;Да</String>
  <String Id="CancelDlgNo" Overridable="yes">&amp;Нет</String>

  <!-- Кнопки навигации -->
  <String Id="WixUIBack" Overridable="yes">&amp;Назад</String>
  <String Id="WixUINext" Overridable="yes">&amp;Далее</String>
  <String Id="WixUICancel" Overridable="yes">Отмена</String>
  <String Id="WixUIFinish" Overridable="yes">&amp;Готово</String>
  <String Id="WixUIInstall" Overridable="yes">&amp;Установить</String>
</WixLocalization>

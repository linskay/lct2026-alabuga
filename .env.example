# =============================================================================
# АРЕНА ПЕРЕГОВОРОВ ОЭЗ «АЛАБУГА» — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# =============================================================================
# Внимание: никогда не коммитьте боевые ключи в репозиторий!
# Файл .env находится в .gitignore и не попадет в коммиты.
# =============================================================================

# 1. ВЫБОР ПРОВАЙДЕРА НЕЙРОСЕТИ
# Допустимые значения: "openrouter" | "gemini" | "local" | "fallback"
# Если не указано, сервер автоматически выберет доступный по наличию ключей.
LLM_PROVIDER="openrouter"

# 2. ВАРИАНТ А: OPENROUTER API (по ключу к лучшим мировым моделям)
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_API_KEY"
# Рекомендуемые лучшие модели под жесткие B2B-переговоры:
# - "anthropic/claude-3.5-sonnet" (эталон логики и ролевого отыгрыша)
# - "deepseek/deepseek-r1" (глубокое рассуждение и аналитика)
# - "meta-llama/llama-3.3-70b-instruct" (быстрый качественный open-source)
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# 3. ВАРИАНТ Б: GOOGLE GEMINI API
# Получить ключ: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# 4. ВАРИАНТ В: ЛОКАЛЬНАЯ / СКАЧАННАЯ МОДЕЛЬ В DOCKER (Ollama / vLLM / llama.cpp)
# Для работы в закрытом контуре безопасности ОЭЗ без доступа в интернет
LOCAL_LLM_URL="http://ollama:11434/v1"
LOCAL_LLM_MODEL="llama3.2"

# 5. НАСТРОЙКИ СЕРВЕРА
PORT=3000
NODE_ENV="production"
